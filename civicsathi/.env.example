# Copy this file to `.env` (local) and set the same variables in Vercel.
# Find both values in Supabase: Project Settings -> API.
# Use ONLY the public "anon" key here. NEVER put the service_role key in this project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: secure serverless/edge function endpoint that calls an AI model for the
# chatbot. Leave empty to use the built-in FAQ assistant (no key needed).
# The function reads OPENAI_API_KEY on the SERVER; never put that key here.
VITE_CHATBOT_AI_URL=
